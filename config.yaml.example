# OctoV configuration. Copy to config.yaml (git-ignored) and adjust.
#
# SECURITY: never put API keys here. The AI key is read ONLY from the
# OCTOV_AI_KEY environment variable; an `api_key` entry in this file is ignored.

ui:
  language: en          # en | az  (az also makes the AI assistant answer in Azerbaijani)
  theme: dark           # dark | light

ai:
  base_url: https://openrouter.ai/api/v1
  model: nvidia/nemotron-3-ultra-550b-a55b:free
  # Optional OpenAI-compatible fallback (e.g. local Ollama / LM Studio). No key required.
  fallback_base_url: null   # e.g. http://localhost:11434/v1
  fallback_model: null      # e.g. qwen2.5-coder:14b
  timeout_s: 60
  max_chars: 24000         # size limit of the evidence shown to you and sent to the AI analyst

static:
  max_file_size_mb: 256

dynamic:
  enabled: false        # dynamic analysis arrives in M3 (Frida 16.x, Job Object + AppContainer)
  symbol_cache: ~/.octov/symbols
  symbol_server: https://msdl.microsoft.com/download/symbols

rules:
  paths:                # relative to this file
    - rules/evasion_patterns.yaml
    - rules/pic_patterns.yaml

# Optional engines (assisted triage phase 2). Install: python -m uv sync --extra capa --extra floss
# capa also needs its rules once: octov ext setup capa
extensions:
  capa:
    timeout_s: 600        # a run longer than this is stopped and reported as failed
    max_size_mb: 64       # larger samples are skipped (unavailable)
    max_memory_mb: 4096   # memory limit for the engine process (Job Object)
  floss:
    timeout_s: 600
    max_size_mb: 64
    max_memory_mb: 4096
  ghidra:                 # decompiler: python -m uv sync --extra ghidra; octov ext setup ghidra
    max_memory_mb: 4096   # per Ghidra worker (JVM heap is a bit below)
    max_workers: 2        # Ghidra workers alive at once (one first-time analysis at a time)
    idle_minutes: 10      # stop idle workers; they restart from the saved project
    decompile_timeout_s: 30
    analysis_timeout_s: 900
    project_keep_days: 30
    # install_dir: C:/tools/ghidra_12.2_PUBLIC   # an existing Ghidra 12.x
    # java_home: C:/Program Files/Eclipse Adoptium/jdk-25.0.1.8-hotspot   # JDK >= 21
